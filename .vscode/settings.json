{
    "editor.formatOnSave": true,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
    },
    "python.defaultInterpreterPath": ".venv/bin/python",
    "rust-analyzer.check.command": "clippy",
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
    },
    "cSpell.ignorePaths": [
        "day*/test.txt",
        "day*/input.txt"
    ],
    "cSpell.words": [
        "heapify",
        "joltage",
        "Octree"
    ]
}